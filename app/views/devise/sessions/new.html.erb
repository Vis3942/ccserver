<h2 class="text-center m-5">Log in</h2>

<div class="container">

  <div class="col-sm-6 offset-sm-3  ccsform">
    <span class="border">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), :html => { :class => "ccsadjust" } )  do |f| %>
      <div class="form-group row">
        <%= f.label :email, class: "col-sm-2 offset-sm-1 col-form-label" %><br />
        <div class="col-sm-8">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control' %>
        </div>
      </div>

      <div class="form-group row">
        <%= f.label :password, class: "col-sm-2 offset-sm-1 col-form-label"  %><br />
        <div class="col-sm-8">
          <%= f.password_field :password, autocomplete: "current-password", class: 'form-control'  %>
        </div>
      </div>

      <div class="form-group row">
        <div class="col-sm-10 offset-sm-5" >
          <%= f.submit "Log in", class: 'btn btn-secondary ccbtn' %>
        </div>
      </div>
    <% end %>
    </span>
  </div>
</div>